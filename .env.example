# Copia este archivo como .env y rellena los valores. Nunca subas .env a git.

# Token de GitHub (fine-grained, solo lectura de repos públicos basta).
# Créalo en: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Clave de la API de Anthropic. Créala en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo para el enriquecimiento (categoría, descripción y ejemplos).
# claude-opus-5-5 da la mejor calidad. claude-haiku-5-5 cuesta ~40 veces menos (ver config/ia.toml).
ANTHROPIC_MODEL=claude-haiku-5-5

# Base de datos local (SQLite). En la fase 6 se migra a Supabase.
DATABASE_PATH=data/radar.db

# Si quedan menos peticiones que esto en GitHub, el healthcheck avisa.
GITHUB_MIN_REMAINING=500
